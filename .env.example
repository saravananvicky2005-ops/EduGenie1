# Copy this file to ".env" and put your real key in it.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...your_key_here

# Gemini model used for Q&A, quiz, summary and learning path.
# The document used gemini-1.5-pro, which Google has retired. gemini-2.5-flash is closed to new users,
# so the current model is the default. If this ever returns 404, pick a newer one from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Backup models tried in order when the main one is overloaded (503) or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Explanation module: "local" = LaMini-Flan-T5-783M (default, ~3 GB first-run download)
#                     "gemini" = use Gemini instead (no download, fastest to start)
EXPLAIN_BACKEND=local

# If the local model cannot load or run, fall back to Gemini automatically.
EXPLAIN_FALLBACK_TO_GEMINI=true

# Optional: "cpu", "cuda" or "mps". Leave empty to auto-pick cuda if available, else cpu.
EXPLAIN_DEVICE=
